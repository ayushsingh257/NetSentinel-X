# NetSentinel-X V2 Production Environment Variables Template
# Copy this file to .env.production on your VPS / Deployment Host

# ─── Application Runtime ──────────────────────────────────────────────────────
GIN_MODE=release
PORT=8080
FRONTEND_URL=https://netsentinel-x.vercel.app
CORS_ALLOWED_ORIGINS=https://*.vercel.app,https://netsentinel-x.vercel.app

# ─── Supabase Managed PostgreSQL Configuration ───────────────────────────────
# Recommended Connection Modes for Persistent Go Backend:
# Option A (Direct Connection - Port 5432, full prepared statements, stateful server):
# SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_STRONG_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Option B (Supavisor Session Pooling - Port 5432, IPv4-friendly persistent server):
# SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_STRONG_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Option C (Discrete Managed Host Variables):
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_HIGH_ENTROPY_SUPABASE_PASSWORD_HERE
DB_NAME=postgres
DB_SSLMODE=require

# ─── Migration Control ────────────────────────────────────────────────────────
# In production, set to false so application startup verifies schema compatibility without auto-mutating.
# Run migrations explicitly via: go run ./cmd/migrate --up (or ./migrate --up)
AUTO_MIGRATE=false

# ─── Connection Pool Tuning (Tuned for Persistent Go Server) ─────────────────
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m

# ─── Managed Redis Cache Configuration ────────────────────────────────────────
# For Managed Redis (e.g. Upstash, AWS ElastiCache), set REDIS_HOST to managed endpoint.
REDIS_HOST=redis:6379
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_HERE

# ─── Secrets & Cryptography ──────────────────────────────────────────────────
# Cryptographically random RS256 / HS256 JWT secret passphrase
JWT_SECRET=CHANGE_THIS_TO_A_64_CHAR_HEX_SECRET_KEY_IN_PRODUCTION
VAULT_ADDR=https://vault.internal:8200
VAULT_TOKEN=YOUR_VAULT_PRODUCTION_TOKEN_HERE

# ─── SIEM & Log Retentions ────────────────────────────────────────────────────
SIEM_LOG_RETENTION_DAYS=365
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=CHANGE_THIS_TO_AES_256_PASSPHRASE
